<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.via.shinvia.mydata.mapper.FinancialInstitutionMapper">
    <select id="findBankOrgCodes" resultType="string">
        SELECT org_code
        FROM financial_institution
        WHERE institution_type = 'BANK'
    </select>
</mapper>