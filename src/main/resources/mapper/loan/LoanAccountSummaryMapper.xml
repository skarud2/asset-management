<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.via.shinvia.loan.ratesimulation.common.mapper.LoanAccountSummaryMapper">

    <select id="findById"
            resultType="com.via.shinvia.loan.ratesimulation.common.entity.LoanAccountSummary">

        SELECT
        loan_account_id,
        loan_type,
        current_balance,
        interest_rate,
        rate_type,
        repayment_type,
        maturity_at,
        data_as_of_at,
        loan_status
        FROM loan_account
        WHERE loan_account_id = #{loanAccountId}

    </select>

</mapper>
